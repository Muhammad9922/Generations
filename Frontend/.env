# Environment for the Generations frontend.
#
# Vite loads this file for every mode, then .env.local (yours, git-ignored) on
# top of it, then .env.[mode] / .env.[mode].local. Only names starting with
# VITE_ reach the app, and every one of them is substituted into the bundle as a
# literal — so they configure the app and must never hold a secret.
#
# The values below are the same defaults the code falls back to when a name is
# missing. They are written out so the knobs are visible and changeable without
# touching source.

# Where the browser sends API calls.
#   /api              (default) same origin, so the dev proxy below forwards it
#                     to the Go server and nothing needs CORS handling.
#   http://host:port  call the API directly. The Go server sends no CORS
#                     headers, so this only works when the API is on the origin
#                     the app was loaded from.
VITE_API_BASE_URL=/api

# Where the dev server forwards /api. Read by vite.config.ts in Node, not by the
# browser, so it needs no VITE_ prefix to work — it has one to keep every
# setting under a single prefix. Pair it with the Go server's own API_ADDR.
VITE_API_PROXY_TARGET=http://localhost:8080

# [api-contract] logging in DevTools.
#   true   always log
#   false  never log
#   unset  log while developing only
VITE_API_CONTRACT_DEBUG=
